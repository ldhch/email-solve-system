# Env / secrets
.env
*.env.local

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# Node / frontend (added from Phase 2)
node_modules/
frontend/dist/

# Local data (SQLite DB, attachments, exports, secrets)
data/*
!data/.gitkeep
!data/attachments/
!data/attachments/.gitkeep
!data/exports/
!data/exports/.gitkeep

# Backend-local data dir must never be committed (secrets.bin could land here
# from older path logic); keep it ignored even if it ever exists.
backend/data/*
!backend/data/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Playwright MCP artifacts
.playwright-mcp/

# ============================================================
# shouhou-agent — environment configuration template
# Copy this file to `.env` and fill in real values.
# NEVER commit real credentials. All keys here are placeholders.
# ============================================================

# ---- App ----
APP_NAME=shouhou-agent
APP_ENV=development
# JWT signing key for owner login (required from Phase 2; keep a long random string)
SECRET_KEY=
# Fernet encryption key (used from Phase 4 secrets-at-rest; base64 32-byte key)
ENCRYPTION_KEY=

# ---- Owner account (Phase 2) ----
# init-db seeds this user only when the user does not exist yet; to change the
# password later run: python -m app.cli create-owner --username boss --password '...'
OWNER_USERNAME=boss
OWNER_PASSWORD=
JWT_EXPIRE_SECONDS=86400

# ---- Database ----
# SQLite only (WAL). Relative paths are resolved against the repo root.
DATABASE_URL=sqlite:///data/app.db

# ---- Mail (Hostinger Titan Email) ----
# Verify the exact IMAP/SMTP host names in the Titan admin panel.
IMAP_HOST=imap.titan.email
IMAP_PORT=993
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USE_SSL=true
EMAIL_USERNAME=your@email.com
EMAIL_PASSWORD=            # Titan app-specific password (required)
MAIL_FROM_NAME=            # optional display name for outbound From

# ---- LLM (DeepSeek default; providers: deepseek | openai | mock) ----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=          # required for provider=deepseek
OPENAI_API_KEY=            # reserved for provider=openai
LLM_BASE_URL=https://api.deepseek.com     # override only if the provider endpoint changes
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
# deepseek-v4-flash is a reasoning model: reasoning tokens count towards this
# budget. If replies get truncated, raise it to 4096.
LLM_MAX_TOKENS=2048
LLM_RETRIES=2              # retries per LLM call before failure

# ---- Alerting (reserved, used from Phase 4) ----
ALERT_BARK_WEBHOOK=
ALERT_EMAIL_TO=

# ---- Scheduling / business rules ----
SESSION_AUTO_CLOSE_DAYS=30
CONVERSATION_SUBJECT_SIMILARITY_THRESHOLD=0.85
LOW_CONFIDENCE_THRESHOLD=0.6
RETENTION_MAX_ATTEMPTS=2
COMPENSATION_MAX_USD=10.0
CONVERSATION_WINDOW_DAYS=7       # session merge window (days)
POLL_INTERVAL_SECONDS=90         # IMAP polling interval for the Phase-1 runner loop

# ---- AI internal service token ----
# Reserved for AI-internal API calls (TECH 6.2); admin endpoints use the JWT
# httpOnly cookie from Phase 2.
AGENT_SERVICE_TOKEN=

# ---- SMTP send policy ----
SMTP_RATE_LIMIT_PER_HOUR=6       # 0 = unlimited; production suggestion: 6
IMAP_TIMEOUT=30
SMTP_TIMEOUT=30

# ---- Retention (Phase 2, M-13) ----
# Optional return-handling text appended to "release" replies (return address
# etc.). Empty => the reply asks the customer for their order number first.
RETURN_POLICY_TEXT=

# ---- Optional overrides ----
# CHARGEBACK_KEYWORDS=chargeback,dispute,credit card company
# ATTACHMENT_DIR=data/attachments
